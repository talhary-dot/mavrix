{
  "name": "mavrix-realty-ssr",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --outDir dist/client && node -e \"fs.copyFileSync('dist/client/index.html', 'dist/template.html'); fs.unlinkSync('dist/client/index.html')\"",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist/server",
    "serve": "cross-env NODE_ENV=production node server.js"
  },
  "dependencies": {
    "compression": "^1.7.5",
    "cross-env": "^7.0.3",
    "express": "^4.21.2",
    "lucide-react": "^1.54.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.0",
    "vite": "^8.0.0"
  }
}
